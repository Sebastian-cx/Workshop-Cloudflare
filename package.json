{
  "name": "osint-workshop-registration-platform",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "npx tsc && npx vite build",
    "lint": "npx tsc --noEmit",
    "preview": "vite preview",
    "wrangler:dev": "wrangler dev",
    "deploy": "npm run build && wrangler deploy",
    "d1:migrate:local": "wrangler d1 execute osint-workshop-db --local --file=./migrations/0000_initial_schema.sql",
    "d1:migrate:prod": "wrangler d1 execute osint-workshop-db --remote --file=./migrations/0000_initial_schema.sql"
  },
  "dependencies": {
    "@hookform/resolvers": "^3.9.0",
    "canvas-confetti": "^1.9.3",
    "clsx": "^2.1.1",
    "lucide-react": "^0.446.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-hook-form": "^7.53.0",
    "tailwind-merge": "^2.5.2",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/canvas-confetti": "^1.9.0",
    "@types/node": "^22.7.4",
    "@types/react": "^18.3.10",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.2",
    "autoprefixer": "^10.4.20",
    "postcss": "^8.4.47",
    "tailwindcss": "^3.4.13",
    "typescript": "^5.6.2",
    "vite": "^5.4.8",
    "wrangler": "^4.134.0"
  }
}
